# Backend configuration. Every value is optional in development; the defaults
# shown are used when a variable is unset. The app reads the process
# environment, so export them before starting uvicorn, for example:
#   cp .env.example .env && set -a && source .env && set +a

# "development" or "production". Production defaults the cookie to Secure.
APP_ENV=development

# SQLite database file. In production point this at a persistent disk.
DATABASE_PATH=./data/route53.db

# Comma-separated browser origins allowed to call the API with cookies.
# Only needed when the frontend calls the API cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session cookie settings for the mocked sign-in.
SESSION_COOKIE_NAME=r53_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12

# The single demo IAM user.
DEMO_ACCOUNT_ID=123456789012
DEMO_USERNAME=demo
DEMO_PASSWORD=Route53Demo!

# Insert the demo hosted zones once, the first time the database is created.
SEED_DEMO_DATA=true

LOG_LEVEL=INFO
