APP_ENV=development
DATABASE_PATH=./data/route53.db

# only needed when the frontend calls the API from another origin
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SESSION_COOKIE_NAME=r53_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12

DEMO_ACCOUNT_ID=123456789012
DEMO_USERNAME=demo
DEMO_PASSWORD=Route53Demo!

SEED_DEMO_DATA=true
LOG_LEVEL=INFO
