# Copy to .env.local for local overrides (Next.js loads it automatically).
# Public FastAPI base URL. Next.js proxies /api/* to it, so the browser only
# ever talks to the frontend's own origin. Required for `next build`;
# `next dev` defaults to http://127.0.0.1:8000.
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional alternative: call the API directly from the browser (cross-origin).
# The backend must then list this site in CORS_ALLOWED_ORIGINS and use
# SESSION_COOKIE_SAMESITE=none with SESSION_COOKIE_SECURE=true.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
